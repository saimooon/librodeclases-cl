# Copiar a .dev.vars para desarrollo local (en producción se cargan con `npx wrangler secret put <NOMBRE>`).
BETTER_AUTH_SECRET=
# Opcional: login con Google (ID de cliente OAuth "Aplicación web" de Google Cloud Console).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: login con Facebook (app de Meta for Developers con "Inicio de sesión con Facebook").
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
